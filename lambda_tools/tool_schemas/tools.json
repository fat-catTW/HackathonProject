[
  {
    "name": "list_services",
    "description": "List available home services.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "services": {
          "type": "array"
        }
      },
      "required": [
        "success"
      ]
    }
  },
  {
    "name": "get_service_schema",
    "description": "Get the booking form schema for a specific service, including field metadata such as options, time limits, and conditional visibility.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "description": "Service ID, for example air_conditioner_cleaning."
        }
      },
      "required": [
        "service_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "service_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "description": "Field definitions for the target service form.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["text", "textarea", "number", "date", "time", "select", "file"]
              },
              "required": {
                "type": "boolean"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "minValue": {
                "type": "string",
                "description": "Minimum allowed value, for example 08:30 for time fields."
              },
              "maxValue": {
                "type": "string",
                "description": "Maximum allowed value, for example 18:00 for time fields."
              },
              "step": {
                "type": "integer",
                "description": "Step interval, for example 300 seconds for 5-minute time selection."
              },
              "visibleWhen": {
                "type": "object",
                "properties": {
                  "fieldId": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "fieldId",
                  "value"
                ]
              },
              "question": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "required"
            ]
          }
        }
      },
      "required": [
        "success"
      ]
    }
  },
  {
    "name": "get_page_context",
    "description": "Get structured knowledge for a specific app page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "page_id": {
          "type": "string",
          "description": "Page id such as home, service_form, or request_detail."
        }
      },
      "required": [
        "page_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "page": {
          "type": "object"
        }
      },
      "required": [
        "success"
      ]
    }
  },
  {
    "name": "search_pages",
    "description": "Search relevant app pages by a user question.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "User question about app pages or navigation."
        },
        "current_page_id": {
          "type": "string",
          "description": "Optional current page id."
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "matches": {
          "type": "array"
        }
      },
      "required": [
        "success"
      ]
    }
  },
  {
    "name": "recommend_products_by_health_need",
    "description": "Recommend 7-11 products based on a user's natural-language health or diet need (e.g. weight loss, muscle gain, low sodium). Returns up to 5 matching products with reasons.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "User's health/diet need described in natural language, for example \"我在減脂但想吃點甜食\"."
        }
      },
      "required": ["query"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "query": {
          "type": "string"
        },
        "recommendations": {
          "type": "array"
        },
        "fallback_used": {
          "type": "boolean"
        }
      },
      "required": ["success"]
    }
  },
  {
    "name": "get_product_nutrition",
    "description": "Get full nutrition info (calories, protein, carbs, fat, sodium, tags, allergens) for a single 7-11 product by its product_id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "description": "Product id, for example P001."
        }
      },
      "required": ["product_id"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["success"]
    }
  },
  {
    "name": "submit_service_request",
    "description": "Submit a completed service request form.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "description": "Completed form values matching get_service_schema. Use field ids as keys, HH:MM for time fields, and include conditional fields only when their visibleWhen condition is met."
        }
      },
      "required": [
        "service_id",
        "session_id",
        "payload"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "success"
      ]
    }
  }
]
