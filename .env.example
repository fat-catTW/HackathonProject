# Copy this file to `.env` in the project root or `backend/.env`.

# Local demo mode
USE_MOCK=true

# Switch to AWS-backed mode
# USE_MOCK=false

# AWS credentials
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# Bedrock
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0

# Persistence
DYNAMODB_TABLE_NAME=ServiceAssistant
ALLOW_DEMO_AUTH=true

# 廠商後台帳號（不開放自助註冊，vendor_id 決定看得到哪些案件）
# 留空則使用內建示範帳號 vendor1@demo.local / vendor11@demo.local（密碼 vendor1234）
# VENDOR_ACCOUNTS={"ops@vendor.example":{"vendor_id":1,"name":"潔家家事服務","password":"..."}}
VENDOR_ACCOUNTS=

# 聯絡資訊欄位級加密（姓名／電話／地址在 DynamoDB 裡是密文）
# 兩者都留空會退回內建開發金鑰，僅適用本機 Demo；正式環境請擇一設定。
# CONTACT_KMS_KEY_ID 優先於 CONTACT_ENCRYPTION_KEY，且只在 USE_MOCK=false 時生效。
CONTACT_ENCRYPTION_KEY=
CONTACT_KMS_KEY_ID=

# Tool execution mode
# embedded  = use built-in service catalog, store sessions/requests in DynamoDB
# dynamodb  = read service catalog from DynamoDB SERVICE#... items
# lambda    = invoke the Lambda functions below
# mcp       = call tools through AgentCore Gateway MCP
AGENT_TOOL_MODE=embedded
LIST_SERVICES_LAMBDA_NAME=
GET_SERVICE_SCHEMA_LAMBDA_NAME=
SUBMIT_SERVICE_REQUEST_LAMBDA_NAME=
GET_PAGE_CONTEXT_LAMBDA_NAME=
SEARCH_PAGES_LAMBDA_NAME=
RECOMMEND_PRODUCTS_BY_HEALTH_NEED_LAMBDA_NAME=
GET_PRODUCT_NUTRITION_LAMBDA_NAME=
LIST_SHOP_STORES_LAMBDA_NAME=
GET_SHOP_PRODUCTS_LAMBDA_NAME=
GET_USER_POINTS_LAMBDA_NAME=

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Reserved for future AgentCore integration
AGENTCORE_RUNTIME_ARN=
AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_URL=
AGENTCORE_GATEWAY_MCP_PATH=/mcp
AGENTCORE_GATEWAY_AUTH_SCHEME=Bearer
AGENTCORE_GATEWAY_AUTH_TOKEN=
MCP_LIST_SERVICES_TOOL_NAME=list_services
MCP_GET_SERVICE_SCHEMA_TOOL_NAME=get_service_schema
MCP_SUBMIT_SERVICE_REQUEST_TOOL_NAME=submit_service_request
MCP_GET_PAGE_CONTEXT_TOOL_NAME=get_page_context
MCP_SEARCH_PAGES_TOOL_NAME=search_pages
MCP_RECOMMEND_PRODUCTS_BY_HEALTH_NEED_TOOL_NAME=recommend_products_by_health_need
MCP_GET_PRODUCT_NUTRITION_TOOL_NAME=get_product_nutrition
MCP_LIST_SHOP_STORES_TOOL_NAME=list_shop_stores
MCP_GET_SHOP_PRODUCTS_TOOL_NAME=get_shop_products
MCP_GET_USER_POINTS_TOOL_NAME=get_user_points
